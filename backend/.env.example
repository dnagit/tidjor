# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/tidjor?schema=public"

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:4000/api/auth/facebook/callback

# LINE Login
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:4000/api/auth/line/callback

# TMDB API
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/original

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# AI reviewer (scripts/generateReviews.js)
ANTHROPIC_API_KEY=
OMDB_API_KEY=
AI_REVIEW_MODEL=claude-sonnet-5-5
AI_REVIEW_RESEARCH_MODEL=claude-haiku-5-5
AI_REVIEW_CRON=0 9 * * *
AI_REVIEW_DAILY=8
AI_REVIEW_SERIES=2
# AI news (scripts/generateNews.js) — ข่าวเรื่องใกล้ฉาย เผยแพร่อัตโนมัติ
AI_NEWS_MODEL=claude-haiku-5-5
AI_NEWS_CRON=0 10 * * *
AI_NEWS_DAILY=1
AI_NEWS_MAX_SEARCHES=4
# Top list (scripts/generateLists.js) — ทุกวันจันทร์ 11:00 ครั้งละ 2 หัวข้อ
AI_LIST_CRON=0 11 * * 1
AI_LIST_PER_RUN=2
# แจ้งเตือน Watchlist (ค่าเริ่มต้น 07:00 ทุกวัน, off = ปิด)
NOTIFY_CRON=0 7 * * *
TMDB_SYNC_CRON=0 8 * * *
TMDB_SYNC_PAGES=5
